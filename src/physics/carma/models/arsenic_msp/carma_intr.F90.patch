   integer                        :: icnst4gas(NGAS)               ! constituent index for a carma gas
+!++AS
+  logical                        :: carma_added_gas(NGAS) = .false. ! gas constituent was added by CARMA
+!--AS
 
   character(len=16)              :: btndname(NGROUP, NBIN)        ! names of group per bin tendencies
